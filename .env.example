EPAS_ENV=local
DEBUG_MODE=false
LLM_MODEL_KEY=auxiliator-llm
LANGGRAPH_CHECKPOINTER_BACKEND=memory
LANGGRAPH_CHECKPOINTER_DB_URI=
DOCUMENT_STORE_BACKEND=postgres
DOCUMENT_STORE_HOST=localhost
DOCUMENT_STORE_PORT=5432
DOCUMENT_STORE_DATABASE=context_engine
DOCUMENT_STORE_USER=
DOCUMENT_STORE_PASSWORD=
DOCUMENT_STORE_SCHEMA_NAME=public
DOCUMENT_STORE_TABLE_NAME=knowledge_chunks
EMBEDDING_MODEL_KEY=auxiliator-embeddings
EMBEDDING_DIMENSION=1024
SUBQUERY_COUNT=3
RETRIEVAL_LIMIT=5
RETRIEVAL_THRESHOLD=0.60
AUTO_SEED_KNOWLEDGE=true
KNOWLEDGE_BASE_PATH=knowledge
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
REMOTE_DAG_BASE_URL=
REMOTE_DAG_API_KEY=
REMOTE_DAG_TIMEOUT=30
SECRETS_MOUNT_PATH=/opt/gke/vault/secrets/secrets

# Local LLM API Keys (Optional - set one of these to test with real LLM APIs locally)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL_NAME=gpt-4o-mini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL_NAME=gemini-2.5-flash

